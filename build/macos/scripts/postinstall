#!/bin/bash

# Post-install script for Roon AI

set -e

# Create data directory
mkdir -p /usr/local/var/roon-ai
mkdir -p /usr/local/var/log

# Set permissions
chmod 755 /usr/local/bin/roon-ai

# Load the LaunchDaemon
launchctl load /Library/LaunchDaemons/com.221b.roon-ai.plist 2>/dev/null || true

# Start the service
launchctl start com.221b.roon-ai 2>/dev/null || true

echo "Roon AI installed successfully!"
echo "Web UI available at: http://localhost:8088"

exit 0
