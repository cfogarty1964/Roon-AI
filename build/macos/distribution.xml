<?xml version="1.0" encoding="UTF-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Roon AI</title>
    <organization>com.221b</organization>
    <domains enable_localSystem="true" enable_currentUserHome="false"/>

    <options customize="never" require-scripts="true" hostArchitectures="x86_64,arm64"/>

    <welcome file="welcome.html"/>
    <license file="license.html"/>
    <conclusion file="conclusion.html"/>

    <choices-outline>
        <line choice="default">
            <line choice="com.221b.roon-ai.pkg"/>
        </line>
    </choices-outline>

    <choice id="default"/>

    <choice id="com.221b.roon-ai.pkg"
            visible="false"
            title="Roon AI"
            description="Installs Roon AI service">
        <pkg-ref id="com.221b.roon-ai.pkg"/>
    </choice>

    <pkg-ref id="com.221b.roon-ai.pkg"
             version="VERSION_PLACEHOLDER"
             onConclusion="none">roon-ai.pkg</pkg-ref>
</installer-gui-script>
