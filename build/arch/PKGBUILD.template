# Maintainer: Cloud Atlas AI <support@cloudatlas.ai>
pkgname=roon-ai
pkgver=${VERSION}
pkgrel=1
pkgdesc="Source-agnostic hi-fi control bridge for Roon, LMS, and hardware knobs"
arch=('x86_64' 'aarch64')
url="https://github.com/cfogarty1964/Roon-AI"
license=('custom:PolyForm-Noncommercial-1.0.0')
depends=('glibc')
backup=('etc/roon-ai/config.json')
source_x86_64=("roon-ai-linux-x86_64")
source_aarch64=("roon-ai-linux-aarch64")
sha256sums_x86_64=('${SHA256_X86_64}')
sha256sums_aarch64=('${SHA256_AARCH64}')

package() {
    cd "$srcdir"

    # Determine binary name based on architecture
    if [[ "$CARCH" == "x86_64" ]]; then
        _binary="roon-ai-linux-x86_64"
    else
        _binary="roon-ai-linux-aarch64"
    fi

    # Install binary
    install -Dm755 "$_binary" "$pkgdir/usr/bin/roon-ai"

    # Install systemd service
    install -Dm644 "$srcdir/../roon-ai.service" \
        "$pkgdir/usr/lib/systemd/system/roon-ai.service"

    # Create config directory
    install -dm755 "$pkgdir/etc/roon-ai"

    # Install default config
    cat > "$pkgdir/etc/roon-ai/config.json" << 'EOF'
{
  "port": 8088,
  "logLevel": "info"
}
EOF
    chmod 644 "$pkgdir/etc/roon-ai/config.json"

    # Create data directory for runtime files
    install -dm755 "$pkgdir/var/lib/roon-ai"
}
